<launch>
  <!-- ============================================================ -->
  <!-- Go2+Piper 全栈: Gazebo+感知+导航+MoveIt+抓取                  -->
  <!-- ============================================================ -->
  <arg name="gui" default="true"/>
  <arg name="world" default="$(find unitree_gazebo)/worlds/competition_scene.world"/>

  <!-- ====== 1. Gazebo + 机器人生成 ====== -->
  <include file="$(find go2_piper_description)/launch/gazebo.launch">
    <arg name="gui" value="$(arg gui)"/>
    <arg name="world" value="$(arg world)"/>
  </include>

  <!-- ====== 2. FAST-LIO 里程计 ====== -->
  <node pkg="fast_lio" type="fastlio_mapping" name="laserMapping" output="screen">
    <param name="config_file" value="$(find go2_piper_description)/config/mid360_go2.yaml"/>
    <remap from="/livox/lidar" to="/livox/lidar2"/>
  </node>

  <!-- ====== 3. open3d_loc 全局定位 ====== -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="camera_init2odom"
        args="0 0 0 0 0 0 1 odom camera_init"/>
  <node pkg="tf2_ros" type="static_transform_publisher" name="body2base"
        args="0 0 0 0 0 0 1 base body"/>

  <node pkg="open3d_loc" type="global_localization_node" name="global_localization" output="screen">
    <remap from="/cloud_registered_1" to="/cloud_registered"/>
    <remap from="/Odometry_loc" to="/Odometry"/>
    <rosparam command="load" file="$(find open3d_loc)/config/loc_param_g1.yaml"/>
    <param name="path_map" type="string" value="$(find open3d_loc)/../data/map_output_new.pcd"/>
    <param name="voxelsize_coarse" type="double" value="0.15"/>
    <param name="voxelsize_fine" type="double" value="0.1"/>
    <param name="threshold_fitness" type="double" value="0.5"/>
    <param name="threshold_fitness_init" type="double" value="0.5"/>
    <param name="loc_frequence" type="double" value="2.5"/>
    <param name="maxpoints_source" type="int" value="80000"/>
    <param name="maxpoints_target" type="int" value="400000"/>
    <param name="confidence_loc_th" type="double" value="0.7"/>
    <param name="dis_updatemap" type="double" value="3.5"/>
  </node>

  <!-- ====== 4. 导航 (EGO-Planner + traj_server) ====== -->
  <include file="$(find go2_piper_description)/launch/go2_nav.launch">
    <arg name="flight_type" value="1"/>
  </include>

  <!-- ====== 5. MoveIt 运动规划 ====== -->
  <include file="$(find go2_piper_moveit_config)/launch/move_group.launch">
    <arg name="rviz" value="false"/>
  </include>

  <!-- ====== 6. 物体检测 ====== -->
  <node pkg="go2_piper_description" type="object_detector.py"
        name="object_detector" output="screen">
    <param name="target_name" value="target_cube"/>
  </node>

  <!-- ====== 7. 全自动任务调度 ====== -->
  <node pkg="go2_piper_description" type="full_station.py"
        name="full_station" output="screen"/>
      
</launch>
