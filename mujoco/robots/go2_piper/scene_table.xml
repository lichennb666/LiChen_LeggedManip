<mujoco model="go2piper table scene">
  <include file="go2piper.xml"/>

  <statistic center="1.5 -10 0.8" extent="2.5"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="table_mat" rgba="0.6 0.4 0.2 1"/>
    <material name="cube_mat" rgba="0.0 0.8 0.0 1"/>
  </asset>

  <worldbody>
    <light pos="2 -10 3" dir="0 0 -1" directional="true"/>

    <!-- Flat ground -->
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" friction="1.5 0.5 0.5"/>

    <!-- Table: 0.8m wide, 0.6m deep, 0.6m tall, positioned 2m in front of robot -->
    <!-- Table top -->
    <geom name="table_top" type="box" pos="2.0 -10 0.30" size="0.40 0.30 0.02" material="table_mat"/>
    <!-- Table legs -->
    <geom name="leg1" type="box" pos="1.65 -10.25 0.15" size="0.02 0.02 0.15" material="table_mat"/>
    <geom name="leg2" type="box" pos="2.35 -10.25 0.15" size="0.02 0.02 0.15" material="table_mat"/>
    <geom name="leg3" type="box" pos="1.65 -9.75 0.15" size="0.02 0.02 0.15" material="table_mat"/>
    <geom name="leg4" type="box" pos="2.35 -9.75 0.15" size="0.02 0.02 0.15" material="table_mat"/>

    <!-- Target cube on table: 4cm cube -->
    <geom name="target_cube" type="box" pos="2.0 -10 0.36" size="0.02 0.02 0.02" material="cube_mat" mass="0.05"/>

  </worldbody>
</mujoco>
