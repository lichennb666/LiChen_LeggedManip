<?xml version="1.0"?>
<package format="3">
  <name>go2_piper_gazebo_plugins</name>
  <version>0.1.0</version>
  <description>Gazebo Classic double-contact fixed-joint grasp and demo base adapters.</description>
  <maintainer email="lili@robot.com">lili</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>gazebo_dev</depend>
  <depend>gazebo_ros</depend>
  <depend>geometry_msgs</depend>
  <depend>rclcpp</depend>
  <depend>std_srvs</depend>
  <export>
    <build_type>ament_cmake</build_type>
    <gazebo_ros plugin_path="${prefix}/lib"/>
  </export>
</package>
