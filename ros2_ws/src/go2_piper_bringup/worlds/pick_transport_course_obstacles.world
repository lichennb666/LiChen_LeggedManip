<?xml version="1.0"?>
<sdf version="1.6">
  <world name="pick_transport">
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros><namespace>/gazebo</namespace></ros>
      <update_rate>50.0</update_rate>
    </plugin>
    <gui fullscreen="false">
      <camera name="go2_piper_overview">
        <!-- Keep the complete robot and both work surfaces near the centre of
             the initial viewport.  The previous distant pose aimed above the
             work area, placing Go2 at the very bottom of the window where it
             was easily hidden by the terminal used to start Gazebo. -->
        <pose>-1.5 -2.0 1.4 0 0.52 0.78</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>
    <physics name="ode" type="ode">
      <max_step_size>0.005</max_step_size>
      <real_time_update_rate>200</real_time_update_rate>
      <ode><solver><type>quick</type><iters>100</iters><sor>1.0</sor></solver></ode>
    </physics>
    <gravity>0 0 -9.81</gravity>
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>
    <model name="pickup_table">
      <static>true</static>
      <pose>0.45 0.13 0.496 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.55 0.46 0.02</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.55 0.46 0.02</size></box></geometry>
          <material><ambient>0.35 0.25 0.15 1</ambient><diffuse>0.5 0.35 0.2 1</diffuse></material></visual>
      </link>
    </model>
    <model name="drop_table">
      <static>true</static>
      <pose>0.20 -0.30 0.496 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.80 0.40 0.02</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.80 0.40 0.02</size></box></geometry>
          <material><ambient>0.2 0.25 0.35 1</ambient><diffuse>0.3 0.4 0.6 1</diffuse></material></visual>
      </link>
    </model>
    <!-- Orange transport box with a green front handle.  The HSV detector sees
         only the handle, whose centre remains at the old grasp station x=0.48.
         The body rests on the pickup table (top z=0.506). -->
    <model name="target_box">
      <static>false</static>
      <pose>0.61 0.18 0.556 0 0 0</pose>
      <link name="body">
        <inertial>
          <mass>0.20</mass>
          <inertia>
            <ixx>0.0001093</ixx><iyy>0.0001333</iyy><izz>0.0001093</izz>
          </inertia>
        </inertial>
        <collision name="body_collision">
          <surface>
            <friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction>
            <contact><ode><kp>300000</kp><kd>30</kd><max_vel>0.005</max_vel><min_depth>0.001</min_depth></ode></contact>
          </surface>
          <geometry><box><size>0.10 0.08 0.10</size></box></geometry>
        </collision>
        <visual name="body_visual">
          <geometry><box><size>0.10 0.08 0.10</size></box></geometry>
          <material><ambient>0.55 0.18 0.05 1</ambient><diffuse>0.75 0.25 0.06 1</diffuse></material>
        </visual>
      </link>
      <link name="handle">
        <pose>-0.130 0 0 0 0 0</pose>
        <inertial>
          <mass>0.01</mass>
          <inertia><ixx>0.000004</ixx><iyy>0.000004</iyy><izz>0.000001</izz></inertia>
        </inertial>
        <collision name="grip_collision">
          <surface>
            <friction><ode><mu>15.0</mu><mu2>15.0</mu2><slip1>0.0</slip1><slip2>0.0</slip2></ode></friction>
            <contact><ode><kp>300000</kp><kd>30</kd><max_vel>0.005</max_vel><min_depth>0.001</min_depth></ode></contact>
          </surface>
          <geometry><box><size>0.018 0.018 0.060</size></box></geometry>
        </collision>
        <collision name="upper_mount_collision"><pose>0.040 0 0.030 0 0 0</pose><geometry><box><size>0.080 0.018 0.018</size></box></geometry></collision>
        <collision name="lower_mount_collision"><pose>0.040 0 -0.030 0 0 0</pose><geometry><box><size>0.080 0.018 0.018</size></box></geometry></collision>
        <visual name="grip_visual">
          <geometry><box><size>0.018 0.018 0.060</size></box></geometry>
          <material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material>
        </visual>
        <visual name="upper_mount_visual"><pose>0.040 0 0.030 0 0 0</pose><geometry><box><size>0.080 0.018 0.018</size></box></geometry><material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material></visual>
        <visual name="lower_mount_visual"><pose>0.040 0 -0.030 0 0 0</pose><geometry><box><size>0.080 0.018 0.018</size></box></geometry><material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material></visual>
      </link>
      <joint name="body_to_handle" type="fixed"><parent>body</parent><child>handle</child></joint>
    </model>
    <!-- Obstacles copied from the course playground jersey_barrier geometry. -->
    <model name="course_jersey_barrier_01">
      <static>true</static>
      <pose>1.45 -0.85 0 0 0 0</pose>
      <link name="link">
        <collision name="upright"><pose>0 0 0.5715 0 0 0</pose><geometry><box><size>1.50 0.3063 1.143</size></box></geometry></collision>
        <collision name="base"><pose>0 0 0.032258 0 0 0</pose><geometry><box><size>1.50 0.8107 0.064516</size></box></geometry></collision>
        <collision name="base2"><pose>0 0 0.1 0 0 0</pose><geometry><box><size>1.50 0.65 0.1</size></box></geometry></collision>
        <collision name="base3"><pose>0 0 0.2 0 0 0</pose><geometry><box><size>1.50 0.5 0.1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.50 0.3063 1.143</size></box></geometry><material><ambient>0.9 0.45 0.05 1</ambient><diffuse>0.95 0.55 0.08 1</diffuse></material></visual>
      </link>
    </model>
    <model name="course_jersey_barrier_02">
      <static>true</static>
      <pose>1.45 0.65 0 0 0 1.5708</pose>
      <link name="link">
        <collision name="upright"><pose>0 0 0.5715 0 0 0</pose><geometry><box><size>1.50 0.3063 1.143</size></box></geometry></collision>
        <collision name="base"><pose>0 0 0.032258 0 0 0</pose><geometry><box><size>1.50 0.8107 0.064516</size></box></geometry></collision>
        <collision name="base2"><pose>0 0 0.1 0 0 0</pose><geometry><box><size>1.50 0.65 0.1</size></box></geometry></collision>
        <collision name="base3"><pose>0 0 0.2 0 0 0</pose><geometry><box><size>1.50 0.5 0.1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.50 0.3063 1.143</size></box></geometry><material><ambient>0.9 0.45 0.05 1</ambient><diffuse>0.95 0.55 0.08 1</diffuse></material></visual>
      </link>
    </model>
    <model name="course_jersey_barrier_03">
      <static>true</static>
      <pose>-0.65 -0.85 0 0 0 0</pose>
      <link name="link">
        <collision name="upright"><pose>0 0 0.5715 0 0 0</pose><geometry><box><size>1.20 0.3063 1.143</size></box></geometry></collision>
        <collision name="base"><pose>0 0 0.032258 0 0 0</pose><geometry><box><size>1.20 0.8107 0.064516</size></box></geometry></collision>
        <collision name="base2"><pose>0 0 0.1 0 0 0</pose><geometry><box><size>1.20 0.65 0.1</size></box></geometry></collision>
        <collision name="base3"><pose>0 0 0.2 0 0 0</pose><geometry><box><size>1.20 0.5 0.1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.20 0.3063 1.143</size></box></geometry><material><ambient>0.9 0.45 0.05 1</ambient><diffuse>0.95 0.55 0.08 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
